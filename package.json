{
  "name": "triage-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for triaging a GitHub issue before writing a fix",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "triage-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "start": "node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.0"
  }
}
